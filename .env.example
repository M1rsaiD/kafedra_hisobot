# Скопируйте в .env и при необходимости поменяйте.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Язык интерфейса по умолчанию: uz или ru (переключатель есть в шапке сайта)
LANGUAGE_CODE=uz

# sqlite — для локального запуска; mysql — для сервера
DB_ENGINE=sqlite
